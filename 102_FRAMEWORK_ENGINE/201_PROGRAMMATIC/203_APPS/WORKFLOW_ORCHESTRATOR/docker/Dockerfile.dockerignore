!pyproject.toml
!uv.lock
!102_FRAMEWORK_ENGINE
!102_FRAMEWORK_ENGINE/**
**/.env
**/.env.*
**/*.env
**/auth.json
**/.git
**/__pycache__
**/.venv
**/venv
**/node_modules
**/.DS_Store
**/.caprmedio_tmp
**/.caprmedio_install
**/.caprmedio_runtime
**/tmp
